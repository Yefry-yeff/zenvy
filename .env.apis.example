# Variables de Entorno - Módulo APIs y Webhooks

# ==============================================================================
# WEBHOOKS OUTGOING (Sincronización con Servicios Externos)
# ==============================================================================

# Activar/desactivar el envío de webhooks
WEBHOOK_ENABLED=true

# URL del endpoint que recibirá los webhooks
# Ejemplo: https://tu-ecommerce.com/api/webhooks/inventario
WEBHOOK_URL=

# Token de autenticación para los webhooks (Bearer token)
# Genera uno seguro con: php artisan webhooks:test --evento=generar-token
WEBHOOK_TOKEN=

# Timeout en segundos para requests de webhook (default: 5)
WEBHOOK_TIMEOUT=5

# Número de reintentos en caso de fallo (default: 3)
WEBHOOK_RETRY_ATTEMPTS=3

# Verificar certificado SSL (true/false)
# En desarrollo con HTTPS autofirmado, cambiar a false
WEBHOOK_VERIFY_SSL=true

# Registrar requests y responses en logs (true/false)
WEBHOOK_LOG_REQUESTS=true
WEBHOOK_LOG_RESPONSES=true

# Enviar webhooks de forma asíncrona (true/false)
# Recomendado: true (requiere queue configurado)
WEBHOOK_ASYNC=true

# ==============================================================================
# WEBHOOKS INCOMING (Recepción desde Servicios Externos)
# ==============================================================================

# Token para validar webhooks entrantes
# Debe coincidir con el token configurado en el servicio externo
WEBHOOK_INVENTORY_TOKEN=

# ==============================================================================
# SISTEMA DE COLAS (Para webhooks asíncronos)
# ==============================================================================

# Tipo de cola: sync, database, redis, sqs
# sync = síncrono (no recomendado para producción)
# database = usar base de datos (recomendado para empezar)
# redis = más rápido (requiere Redis instalado)
QUEUE_CONNECTION=database

# ==============================================================================
# API CONFIGURATION
# ==============================================================================

# Versión del API
API_VERSION=v1

# Rate limiting (requests por minuto)
API_RATE_LIMIT=60

# Driver de autenticación: jwt, api_key
API_AUTH_DRIVER=jwt

# Secret para JWT (dejar vacío para usar APP_KEY)
API_JWT_SECRET=

# TTL del token JWT en segundos (3600 = 1 hora)
API_TOKEN_TTL=3600

# TTL del refresh token en segundos (86400 = 24 horas)
API_REFRESH_TTL=86400

# Incluir stack trace en errores del API (solo desarrollo)
API_INCLUDE_TRACE=false

# Pretty print JSON responses (solo desarrollo)
API_PRETTY_PRINT=false

# Habilitar auditoría de requests del API
API_AUDIT_ENABLED=true

# Orígenes permitidos para CORS (separados por coma)
# * = todos, o especificar: https://tu-dominio.com,https://otro-dominio.com
API_ALLOWED_ORIGINS=*

# ==============================================================================
# LOGGING Y MONITOREO
# ==============================================================================

# Canal de log principal
LOG_CHANNEL=stack

# Nivel de log: debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=info

# Canal para logs de deprecación
LOG_DEPRECATIONS_CHANNEL=null

# ==============================================================================
# EJEMPLO DE CONFIGURACIÓN COMPLETA
# ==============================================================================

# Para desarrollo local:
# WEBHOOK_ENABLED=true
# WEBHOOK_URL=https://test.com/webhook
# WEBHOOK_TOKEN=test_token_123456
# QUEUE_CONNECTION=sync

# Para producción:
# WEBHOOK_ENABLED=true
# WEBHOOK_URL=https://produccion.com/api/webhooks/inventario
# WEBHOOK_TOKEN=WmVudnktUE9TLTIwMjYwMTIzMjMzNTMxLTFjQTZHOWI4UlRTVVZMQ0Qwcm01d096ZHRmam9CYU1J
# QUEUE_CONNECTION=database
# API_RATE_LIMIT=120
