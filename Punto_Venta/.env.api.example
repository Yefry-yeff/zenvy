# ================================================
# CONFIGURACIÓN DEL API REST - Sistema POS Zenvy
# ================================================

# --------------------------------------------
# API - Autenticación
# --------------------------------------------
# Driver de autenticación (jwt recomendado)
API_AUTH_DRIVER=jwt

# Secret para firmar tokens JWT (CAMBIAR EN PRODUCCIÓN)
# Generar con: php -r "echo bin2hex(random_bytes(32));"
API_JWT_SECRET=cambiar-por-una-clave-segura-de-minimo-32-caracteres

# Tiempo de vida del token en segundos (3600 = 1 hora)
API_TOKEN_TTL=3600

# Tiempo de vida del refresh token en segundos (86400 = 24 horas)
API_REFRESH_TTL=86400

# --------------------------------------------
# API - Rate Limiting
# --------------------------------------------
# Número máximo de requests por minuto (por cliente)
API_RATE_LIMIT=60

# --------------------------------------------
# API - Auditoría
# --------------------------------------------
# Habilitar auditoría de requests
API_AUDIT_ENABLED=true

# Días de retención de logs (0 = indefinido)
API_AUDIT_RETENTION_DAYS=90

# --------------------------------------------
# API - CORS
# --------------------------------------------
# Dominios permitidos (separados por coma)
# Ejemplos:
#   - Desarrollo: http://localhost,http://localhost:3000
#   - Producción: https://tienda.com,https://www.tienda.com
API_ALLOWED_ORIGINS=http://localhost

# --------------------------------------------
# API - Cache
# --------------------------------------------
# Tiempo de caché para inventario en segundos (300 = 5 minutos)
API_INVENTORY_CACHE_TTL=300

# --------------------------------------------
# API - Inventario
# --------------------------------------------
# Timeout para locks de stock en segundos
API_STOCK_LOCK_TIMEOUT=10

# Umbral de stock bajo
API_LOW_STOCK_THRESHOLD=5

# --------------------------------------------
# API - Paginación
# --------------------------------------------
# Items por página por defecto
API_DEFAULT_PER_PAGE=50

# Máximo de items por página
API_MAX_PER_PAGE=200

# --------------------------------------------
# API - Debugging (Solo desarrollo)
# --------------------------------------------
# Incluir stack trace en errores (false en producción)
API_INCLUDE_TRACE=false

# Pretty print JSON (false en producción por performance)
API_PRETTY_PRINT=false

# ================================================
# NOTAS IMPORTANTES
# ================================================
#
# 1. NUNCA compartir API_JWT_SECRET
# 2. Cambiar API_JWT_SECRET en producción
# 3. Configurar API_ALLOWED_ORIGINS solo con dominios autorizados
# 4. Ajustar API_RATE_LIMIT según necesidades
# 5. Mantener API_AUDIT_ENABLED=true para trazabilidad
#
# ================================================
